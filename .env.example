# Example environment variables
# Copy this file to .env and replace the values with your own

# --- Server Settings ---
# PORT=80

# --- Authentication Settings ---
# Optional: Set a password to require authentication to access the app
# AUTH_PASSWORD=your_secure_password_here

# Optional: Set a custom JWT secret for session signing (auto-generated if omitted)
# JWT_SECRET=your_random_secret_string

# Optional: WebAuthn passkey domain and origin overrides (auto-detected if omitted)
# RP_ID=localhost
# ORIGIN=http://localhost

# --- qBittorrent Settings ---
# The URL of your qBittorrent instance
QBITTORRENT_URL=http://localhost:8080

# Optional: qBittorrent auto-login credentials
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=adminadmin

# --- Sonarr Settings ---
# Sonarr backend connection
SONARR_URL=http://localhost:8989
# Optional: Required only if you want to use Sonarr features
# SONARR_API_KEY=your_sonarr_api_key_here

# --- Radarr Settings ---
# Radarr backend connection
RADARR_URL=http://localhost:7878
# Optional: Required only if you want to use Radarr features
# RADARR_API_KEY=your_radarr_api_key_here
