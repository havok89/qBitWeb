# Example environment variables
# Copy this file to .env and replace the values with your own

# The URL of your qBittorrent instance
# Used for both standalone Docker deployment and local Vite development proxy
QBITTORRENT_URL=http://192.168.1.100:8080

# Sonarr backend connection
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key_here

# Radarr backend connection
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key_here
