server {
    listen       80;
    server_name  localhost;

    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # Proxy to qBittorrent backend (set via QBITTORRENT_URL env var)
        # Default fallback to localhost if not provided (though in docker it likely won't work)
        proxy_pass ${QBITTORRENT_URL}/api/;
        
        # Spoof Origin and Referer to bypass qBittorrent CSRF protection when accessing via localhost
        proxy_set_header Origin ${QBITTORRENT_URL};
        proxy_set_header Referer ${QBITTORRENT_URL}/;
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Cookie $http_cookie;
    }

    location /sonarr/api/ {
        # Proxy to Sonarr backend
        proxy_pass ${SONARR_URL}/api/;
        
        # Inject the Sonarr API Key
        proxy_set_header X-Api-Key ${SONARR_API_KEY};
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
